---
/**
 * Terms of Service — youZen.
 *
 * Structure mirrors the unFunnelizer terms page, rewritten for a free,
 * open-source extension with no paid tiers.
 */
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const lastUpdated = "Last updated: June 2, 2026";
const repo = "https://github.com/rheav/youzen";
---

<Layout
  title="Terms of Service — youZen"
  description="Terms of Service for the youZen Chrome extension."
>
  <Navbar />
  <main class="relative z-10 min-h-screen px-4 pt-32 pb-20 md:px-6">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-4xl font-medium tracking-tight md:text-5xl">
        Terms of <span class="legal-accent">Service</span>
      </h1>
      <p class="mt-4 text-stone-500">{lastUpdated}</p>

      <div class="mt-10 space-y-6">
        <section class="legal-card">
          <h2 class="legal-h2">1. Acceptance of terms</h2>
          <p class="legal-p">
            By installing or using the youZen Chrome extension (the "Service"),
            you agree to these Terms of Service. If you do not agree, please do
            not use the Service.
          </p>
        </section>

        <section class="legal-card">
          <h2 class="legal-h2">2. What youZen does</h2>
          <p class="legal-p">
            youZen is a free, open-source browser extension that quiets
            YouTube. It runs only on YouTube and lets you:
          </p>
          <ul class="legal-ul">
            <li>
              <strong class="text-ink">Hide</strong> — remove Shorts, comments,
              related videos, end-screen cards, and other on-page clutter
            </li>
            <li>
              <strong class="text-ink">Declutter</strong> — replace or empty
              the homepage feed and tidy search results
            </li>
            <li>
              <strong class="text-ink">Block</strong> — hide videos by keyword
              or channel using your own block lists
            </li>
            <li>
              <strong class="text-ink">Pause</strong> — switch youZen off per
              tab or globally, keeping your settings intact
            </li>
          </ul>
          <p class="legal-p mt-3">
            youZen only changes how YouTube looks in your own browser. It does
            not modify YouTube's servers or your YouTube account.
          </p>
        </section>

        <section class="legal-card">
          <h2 class="legal-h2">3. Your responsibilities</h2>
          <p class="legal-p">You agree to:</p>
          <ul class="legal-ul">
            <li>Use the Service only for lawful, personal purposes</li>
            <li>Comply with YouTube's own terms of service while using it</li>
            <li>Not attempt to misuse or repurpose the Service to harm others</li>
            <li>Comply with all applicable laws and regulations</li>
          </ul>
        </section>

        <section class="legal-card">
          <h2 class="legal-h2">4. Free and open source</h2>
          <p class="legal-p">
            youZen is free to use, with no paid tiers, subscriptions, or in-app
            purchases. The source code is publicly available on
            <a href={repo} class="legal-link" rel="noopener">GitHub</a> under
            the MIT license, which governs how you may use, modify, and
            distribute it.
          </p>
        </section>

        <section class="legal-card">
          <h2 class="legal-h2">5. No warranty</h2>
          <p class="legal-p">
            The Service is provided "as is", without warranties of any kind.
            YouTube changes its layout often, so a given toggle may occasionally
            need updating to keep working. We are not liable for any damages
            arising from the use of, or inability to use, the Service.
          </p>
        </section>

        <section class="legal-card">
          <h2 class="legal-h2">6. Relationship to YouTube</h2>
          <p class="legal-p">
            youZen is an independent project and is not affiliated with,
            endorsed by, or sponsored by YouTube or Google. All trademarks
            belong to their respective owners.
          </p>
        </section>

        <section class="legal-card">
          <h2 class="legal-h2">7. Changes to the Service</h2>
          <p class="legal-p">
            We may update, change, or discontinue the Service or these Terms at
            any time. Significant changes to these Terms will be posted on this
            page. Continued use after a change means you accept the updated
            Terms.
          </p>
        </section>

        <section class="legal-card">
          <h2 class="legal-h2">8. Contact</h2>
          <p class="legal-p">
            Questions about these Terms? Please
            <a href={`${repo}/issues/new`} class="legal-link" rel="noopener">
              open an issue on GitHub</a
            >.
          </p>
        </section>
      </div>

      <div class="mt-12 text-center">
        <a href="/" class="legal-link text-stone-500">← Back to home</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style is:global>
  .legal-accent {
    color: var(--color-leaf-deep);
  }
  .legal-card {
    border: 1px solid rgba(231, 229, 228, 0.8);
    background-color: rgba(255, 255, 255, 0.7);
    border-radius: 1rem;
    padding: 1.5rem 1.6rem;
    backdrop-filter: blur(4px);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
  }
  .legal-h2 {
    color: var(--color-ink);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }
  .legal-p {
    color: var(--color-muted);
    line-height: 1.7;
  }
  .legal-ul {
    margin-top: 0.75rem;
    padding-left: 1.2rem;
    list-style: disc;
    color: var(--color-muted);
    line-height: 1.7;
  }
  .legal-ul > li + li {
    margin-top: 0.4rem;
  }
  .legal-link {
    color: var(--color-leaf-deep);
    background-image: linear-gradient(
      to right,
      var(--color-leaf-deep),
      var(--color-leaf)
    );
    background-repeat: no-repeat;
    background-size: 0% 1.5px;
    background-position: 0 100%;
    transition:
      color 300ms ease,
      background-size 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .legal-link:hover,
  .legal-link:focus-visible {
    background-size: 100% 1.5px;
    outline: none;
  }
</style>
