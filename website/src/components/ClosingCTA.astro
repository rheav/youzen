---
/**
 * ClosingCTA — the final "add to browser" band before the FAQ.
 *
 * Takes the role the old Waitlist section used to play: one last warm nudge
 * to install before the page wraps with questions. Uses the same
 * ChromeButton the hero/navbar use — the product has exactly one CTA.
 *
 * Atmosphere:
 *   - Breathing blob behind the copy for continuity with the rest of the page.
 *   - A soft garden-arc at the base (SVG curve) that hints at grass without
 *     being literal, picking up the leaf-mist color.
 *   - Cursive accent with the `sway` animation so the headline has the same
 *     alive-grass breath as the hero.
 */
import ChromeButton from "./ChromeButton.astro";
---

<section id="install" class="relative overflow-x-clip px-6 py-20 md:py-28">
  <div
    class="blob"
    aria-hidden="true"
    style="top: -10%; left: 15%; width: 520px; height: 520px; background: #8ecae6; opacity: 0.18;"
  >
  </div>
  <div
    class="blob"
    aria-hidden="true"
    style="bottom: -25%; right: 10%; width: 460px; height: 460px; background: #cbaad9; opacity: 0.16;"
  >
  </div>
  <div class="reveal-group relative z-10 mx-auto flex max-w-3xl flex-col items-center text-center">
    <span class="reveal label">Ready when you are</span>
    <h2 class="reveal mt-4 text-4xl leading-[1.05] font-semibold tracking-tight md:text-5xl lg:text-6xl">
      Study <em class="not-italic text-sky">with</em> the video,<br class="hidden md:block" />
      not against your feed.
    </h2>
    <p class="reveal mx-auto mt-6 max-w-[480px] text-base text-stone-600 md:text-lg">
      Install youZen: the transcript sits beside every video, and the noise goes away. The channels you love stay.
    </p>
    <div class="reveal mt-9">
      <ChromeButton>Add to Chrome, free</ChromeButton>
    </div>
    <p class="reveal mt-6 text-xs text-stone-500">
      Free · no account · nothing leaves YouTube · open source
    </p>
  </div>
</section>
