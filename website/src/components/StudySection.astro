---
/**
 * Study — what the transcript panel does, in plain words. The hero already
 * shows it working; this section names each thing once.
 */
import { MousePointerClick, Languages, Search, Download, PencilLine, PanelRight } from "@lucide/astro";

const FEATURES = [
  { icon: PanelRight, title: "Beside the video", text: "Its own column in theater mode, the top of the sidebar otherwise, below the player on a narrow window." },
  { icon: MousePointerClick, title: "Click to jump", text: "Any line or time plays the video from there. The line being spoken is always lit." },
  { icon: Languages, title: "Any language", text: "Translate into any language YouTube offers; the translation sits under each paragraph." },
  { icon: Search, title: "Search it", text: "Ctrl+F inside the panel. “acucar” finds “açúcar”: accents and case don’t matter." },
  { icon: Download, title: "Keep it", text: "Copy the whole thing, or export TXT for notes and SRT or VTT for subtitles." },
  { icon: PencilLine, title: "Fix it", text: "Auto-captions get names wrong. Edit any line; your fixes are saved per video." },
];
---

<section id="study" class="relative overflow-x-clip px-6 py-20 md:py-28">
  <div class="blob" aria-hidden="true" style="top: 10%; left: -10%; width: 460px; height: 460px; background: #8ecae6; opacity: 0.16;"></div>
  <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-[0.9fr_1.1fr] md:gap-16">
    <div class="reveal-group md:sticky md:top-32 md:self-start">
      <span class="reveal label">For studying</span>
      <h2 class="reveal mt-4 text-4xl font-semibold tracking-tight text-balance md:text-5xl">
        A transcript that <em class="not-italic text-say">keeps up</em> with the video.
      </h2>
      <p class="reveal mt-6 max-w-md text-base text-stone-600 md:text-lg">
        Lectures, tutorials, talks in another language. Read along, find the part you need, take it with you.
      </p>
    </div>
    <ul class="reveal-group grid gap-3 sm:grid-cols-2">
      {
        FEATURES.map(({ icon: Icon, title, text }) => (
          <li class="reveal glass study-card rounded-2xl p-5">
            <span class="study-icon">
              <Icon size={16} />
            </span>
            <h3 class="mt-4 text-base font-semibold tracking-tight">{title}</h3>
            <p class="mt-1.5 text-sm text-stone-500">{text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .study-card {
    transition:
      transform 0.15s var(--ease),
      box-shadow 0.15s var(--ease);
  }
  .study-card:hover {
    transform: translateY(-2px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.13);
  }
  .study-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--fill);
    color: var(--sky);
  }
  @media (prefers-reduced-motion: reduce) {
    .study-card:hover {
      transform: none;
    }
  }
</style>
