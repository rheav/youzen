---
/**
 * Navbar — floating frosted-glass pill (Nord dock): brand mark, section
 * links, and the one CTA (Aurora, small).
 */
import ChromeButton from "./ChromeButton.astro";
---

<nav
  class="nav-dock fixed top-4 right-4 left-4 z-40 mx-auto flex max-w-5xl items-center justify-between gap-6 rounded-full py-1.5 pr-1.5 pl-4"
  aria-label="Main"
>
  <a href="/" class="flex items-center gap-2.5" aria-label="youZen home">
    <img src="/favicon.svg" width="28" height="28" alt="" class="rounded-[7px]" />
    <span class="text-[15px] font-semibold tracking-tight text-ink">youZen</span>
  </a>

  <div class="hidden items-center gap-7 text-[13.5px] font-medium md:flex">
    <a href="/#study" class="nav-link">Study</a>
    <a href="/#features" class="nav-link">Declutter</a>
    <a href="/#panel" class="nav-link">Inside</a>
    <a href="/docs" class="nav-link">Docs</a>
    <a href="/#faq" class="nav-link">FAQ</a>
  </div>

  <ChromeButton size="small">Add to Chrome</ChromeButton>
</nav>

<style>
  .nav-dock {
    background: color-mix(in oklab, #363d4e 45%, transparent);
    -webkit-backdrop-filter: blur(22px) saturate(1.7);
    backdrop-filter: blur(22px) saturate(1.7);
    border: 1px solid rgb(255 255 255 / 0.12);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.1),
      0 20px 50px rgb(0 0 0 / 0.35);
  }
  .nav-link {
    color: var(--muted);
    transition: color 0.15s var(--ease);
  }
  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--fg);
    outline: none;
  }
</style>
