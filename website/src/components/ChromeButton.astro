---
/**
 * ChromeButton — the one primary CTA ("add to browser"), Aurora style.
 *
 * Variant 1 "Aurora fluindo", chosen by the user on 2026-11-04: filled with
 * the site's background gradient (sky → violet) flowing slowly, glow behind;
 * on hover it becomes an outline with the gradient and glow on the edges only.
 * Layers and animation live in global.css (`.aurora*`); reduced motion stops
 * the flow.
 */
interface Props {
  href?: string;
  class?: string;
  size?: "default" | "small";
}

const {
  href = "https://chromewebstore.google.com/",
  class: className = "",
  size = "default",
} = Astro.props;
---

<a
  target="_blank"
  rel="noopener noreferrer"
  href={href}
  class:list={["aurora", size === "small" && "is-small", className]}
>
  <i class="aurora-glow" aria-hidden="true"><i></i></i>
  <i class="aurora-halo" aria-hidden="true"><i></i></i>
  <i class="aurora-fill" aria-hidden="true"></i>
  <i class="aurora-ring" aria-hidden="true"></i>
  <span><slot /></span>
</a>
